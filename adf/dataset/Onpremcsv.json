{
	"name": "Onpremcsv",
	"properties": {
		"linkedServiceName": {
			"referenceName": "AzureDataLakeStorage1",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"outputcontainer": {
				"type": "string",
				"defaultValue": "input"
			},
			"table_schema": {
				"type": "string"
			},
			"table_name": {
				"type": "string"
			},
			"foldername": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().table_name",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@dataset().table_schema",
					"type": "Expression"
				},
				"fileSystem": {
					"value": "@dataset().outputcontainer",
					"type": "Expression"
				}
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	},
	"type": "Microsoft.DataFactory/factories/datasets"
}