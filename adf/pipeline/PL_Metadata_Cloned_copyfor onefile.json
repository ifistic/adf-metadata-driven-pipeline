{
	"name": "PL_Metadata_Cloned_copyfor onefile",
	"properties": {
		"activities": [
			{
				"name": "Lookup_metadata",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "controlFileset",
						"type": "DatasetReference",
						"parameters": {
							"inputcontainer": {
								"value": "@pipeline().parameters.p_meta_container",
								"type": "Expression"
							},
							"inputfolder": {
								"value": "@pipeline().parameters.p_meta_folder",
								"type": "Expression"
							},
							"iinputfile": {
								"value": "@pipeline().parameters.p_meta_file",
								"type": "Expression"
							}
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEachTable",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Set variable_for_DateTime",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Filter1').output.value",
						"type": "Expression"
					},
					"batchCount": 1,
					"activities": [
						{
							"name": "Copy tables",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"additionalColumns": [
										{
											"name": "load_date",
											"value": {
												"value": "@variables('v_load_date')",
												"type": "Expression"
											}
										},
										{
											"name": "source_file",
											"value": "$$FILEPATH"
										}
									],
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "MetadataSet",
									"type": "DatasetReference",
									"parameters": {
										"inputcontainer": {
											"value": "@item().inputcontainer",
											"type": "Expression"
										},
										"inputfolder": {
											"value": "@item().inputfolder",
											"type": "Expression"
										},
										"iinputfile": {
											"value": "@item().inputfile",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ParquetSink_dataset",
									"type": "DatasetReference",
									"parameters": {
										"container": {
											"value": "@item().sinkcontainer",
											"type": "Expression"
										},
										"folder": {
											"value": "@concat(item().sinkfolder, '/', item().sqlservertable, '/year=', substring(variables('v_load_date'),0,4), '/month=', substring(variables('v_load_date'),5,2), '/day=', substring(variables('v_load_date'),8,2))",
											"type": "Expression"
										},
										"file": {
											"value": "@item().sinkfile",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "Set variable_for_DateTime",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Filter1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_load_date",
					"value": {
						"value": "@if(empty(pipeline().parameters.p_load_date), formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd'), pipeline().parameters.p_load_date)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "ForEachsqlTable",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "ForEachTable",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup_metadata').output.value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "CopyDataToSqlServer",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "Truncate_table_Script",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "ParquetSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "ParquetReadSettings"
									}
								},
								"sink": {
									"type": "AzureSqlSink",
									"writeBehavior": "insert",
									"sqlWriterUseTableLock": false,
									"tableOption": "autoCreate",
									"disableMetricsCollection": false
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ParquetSink_dataset",
									"type": "DatasetReference",
									"parameters": {
										"container": "@item().sinkcontainer",
										"folder": "@concat(item().sinkfolder, '/', item().sqlservertable, '/year=', substring(variables('v_load_date'),0,4), '/month=', substring(variables('v_load_date'),5,2), '/day=', substring(variables('v_load_date'),8,2))",
										"file": "@item().sinkfile"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "AzureSqlTable_sales",
									"type": "DatasetReference",
									"parameters": {
										"dbname": {
											"value": "@item().sqlserverdatabase",
											"type": "Expression"
										},
										"schema": {
											"value": "@item().sqlserverschema",
											"type": "Expression"
										},
										"table": {
											"value": "@item().sqlservertable",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "Truncate_table_Script",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 2,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_AzureSQL",
								"type": "LinkedServiceReference",
								"parameters": {
									"DBName": {
										"value": "@item().sqlserverdatabase",
										"type": "Expression"
									}
								}
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "NonQuery",
										"text": {
											"value": "IF ('@{item().flag}' = '1' OR '@{item().flag}' = '0')\n   AND OBJECT_ID(N'[@{item().sqlserverschema}].[@{item().sqlservertable}]', N'U') IS NOT NULL\n    TRUNCATE TABLE [@{item().sqlserverschema}].[@{item().sqlservertable}];",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			},
			{
				"name": "Filter1",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "Lookup_metadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup_metadata').output.value",
						"type": "Expression"
					},
					"condition": {
						"value": "@equals(item().flag, '0')",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"p_meta_container": {
				"type": "string",
				"defaultValue": "bronze"
			},
			"p_meta_folder": {
				"type": "string",
				"defaultValue": "metadata"
			},
			"p_meta_file": {
				"type": "string",
				"defaultValue": "adf_metadata_salesdb_complete.csv"
			},
			"p_load_date": {
				"type": "string"
			}
		},
		"variables": {
			"v_load_date": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-10-16T22:17:45Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}