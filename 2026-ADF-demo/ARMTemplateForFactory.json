{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "2026-ADF-demo"
		},
		"AzureSqlDatabaseFromBronze_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabaseFromBronze'"
		},
		"LS_AzureSQL_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AzureSQL'"
		},
		"SqlServer2_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'SqlServer2'"
		},
		"SqlServerFromOnprem_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'SqlServerFromOnprem'"
		},
		"AzureBlobStorage1_properties_typeProperties_serviceEndpoint": {
			"type": "string",
			"defaultValue": "https://ifiokstore1.blob.core.windows.net/"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://ifiokstoragegen2.dfs.core.windows.net/"
		},
		"AzureSqlDatabaseFromBronze_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ifistic.database.windows.net"
		},
		"AzureSqlDatabaseFromBronze_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "SalesDB"
		},
		"AzureSqlDatabaseFromBronze_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "ifistic"
		},
		"LS_AzureSQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ifistic.database.windows.net"
		},
		"LS_AzureSQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "@{linkedService().DBName}"
		},
		"LS_AzureSQL_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "ifistic"
		},
		"SqlServer2_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost"
		},
		"SqlServer2_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "@{linkedService().database}"
		},
		"SqlServer2_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "ifiok"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/PL_Metadata')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Lookup_metadata",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "DelimitedTextSource",
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "DelimitedTextReadSettings"
								}
							},
							"dataset": {
								"referenceName": "controlFileset",
								"type": "DatasetReference",
								"parameters": {
									"inputcontainer": {
										"value": "@pipeline().parameters.p_meta_container",
										"type": "Expression"
									},
									"inputfolder": {
										"value": "@pipeline().parameters.p_meta_folder",
										"type": "Expression"
									},
									"iinputfile": {
										"value": "@pipeline().parameters.p_meta_file",
										"type": "Expression"
									}
								}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "ForEachTable",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "Set variable_for_DateTime",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Lookup_metadata').output.value",
								"type": "Expression"
							},
							"batchCount": 1,
							"activities": [
								{
									"name": "Copy tables",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "DelimitedTextSource",
											"additionalColumns": [
												{
													"name": "load_date",
													"value": {
														"value": "@variables('v_load_date')",
														"type": "Expression"
													}
												},
												{
													"name": "source_file",
													"value": "$$FILEPATH"
												}
											],
											"storeSettings": {
												"type": "AzureBlobFSReadSettings",
												"recursive": true,
												"enablePartitionDiscovery": false
											},
											"formatSettings": {
												"type": "DelimitedTextReadSettings"
											}
										},
										"sink": {
											"type": "ParquetSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "ParquetWriteSettings"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "MetadataSet",
											"type": "DatasetReference",
											"parameters": {
												"inputcontainer": {
													"value": "@item().inputcontainer",
													"type": "Expression"
												},
												"inputfolder": {
													"value": "@item().inputfolder",
													"type": "Expression"
												},
												"iinputfile": {
													"value": "@item().inputfile",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "ParquetSink_dataset",
											"type": "DatasetReference",
											"parameters": {
												"container": {
													"value": "@item().sinkcontainer",
													"type": "Expression"
												},
												"folder": {
													"value": "@concat(item().sinkfolder, '/', item().sqlservertable, '/year=', substring(variables('v_load_date'),0,4), '/month=', substring(variables('v_load_date'),5,2), '/day=', substring(variables('v_load_date'),8,2))",
													"type": "Expression"
												},
												"file": {
													"value": "@item().sinkfile",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						}
					},
					{
						"name": "Set variable_for_DateTime",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "Lookup_metadata",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "v_load_date",
							"value": {
								"value": "@if(empty(pipeline().parameters.p_load_date), formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd'), pipeline().parameters.p_load_date)",
								"type": "Expression"
							}
						}
					},
					{
						"name": "ForEachsqlTable",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "ForEachTable",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Lookup_metadata').output.value",
								"type": "Expression"
							},
							"activities": [
								{
									"name": "CopyDataToSqlServer",
									"type": "Copy",
									"dependsOn": [
										{
											"activity": "Drop_table_Script",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "ParquetSource",
											"storeSettings": {
												"type": "AzureBlobFSReadSettings",
												"recursive": true,
												"enablePartitionDiscovery": false
											},
											"formatSettings": {
												"type": "ParquetReadSettings"
											}
										},
										"sink": {
											"type": "AzureSqlSink",
											"writeBehavior": "insert",
											"sqlWriterUseTableLock": false,
											"tableOption": "autoCreate",
											"disableMetricsCollection": false
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "ParquetSink_dataset",
											"type": "DatasetReference",
											"parameters": {
												"container": "@item().sinkcontainer",
												"folder": "@concat(item().sinkfolder, '/', item().sqlservertable, '/year=', substring(variables('v_load_date'),0,4), '/month=', substring(variables('v_load_date'),5,2), '/day=', substring(variables('v_load_date'),8,2))",
												"file": "@item().sinkfile"
											}
										}
									],
									"outputs": [
										{
											"referenceName": "AzureSqlTable_sales",
											"type": "DatasetReference",
											"parameters": {
												"dbname": {
													"value": "@item().sqlserverdatabase",
													"type": "Expression"
												},
												"schema": {
													"value": "@item().sqlserverschema",
													"type": "Expression"
												},
												"table": {
													"value": "@item().sqlservertable",
													"type": "Expression"
												}
											}
										}
									]
								},
								{
									"name": "Drop_table_Script",
									"type": "Script",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 2,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "LS_AzureSQL",
										"type": "LinkedServiceReference",
										"parameters": {
											"DBName": {
												"value": "@item().sqlserverdatabase",
												"type": "Expression"
											}
										}
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "NonQuery",
												"text": {
													"value": "IF OBJECT_ID(N'[@{item().sqlserverschema}].[@{item().sqlservertable}]', N'U') IS NOT NULL TRUNCATE TABLE [@{item().sqlserverschema}].[@{item().sqlservertable}]",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"p_meta_container": {
						"type": "string",
						"defaultValue": "bronze"
					},
					"p_meta_folder": {
						"type": "string",
						"defaultValue": "metadata"
					},
					"p_meta_file": {
						"type": "string",
						"defaultValue": "adf_metadata_salesdb_complete.csv"
					},
					"p_load_date": {
						"type": "string"
					}
				},
				"variables": {
					"v_load_date": {
						"type": "String"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-10-16T22:17:45Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/controlFileset')]",
				"[concat(variables('factoryId'), '/datasets/MetadataSet')]",
				"[concat(variables('factoryId'), '/datasets/ParquetSink_dataset')]",
				"[concat(variables('factoryId'), '/datasets/AzureSqlTable_sales')]",
				"[concat(variables('factoryId'), '/linkedServices/LS_AzureSQL')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_copy_tables')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "ForEach_tables",
						"type": "ForEach",
						"dependsOn": [],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@pipeline().parameters.pTables",
								"type": "Expression"
							},
							"activities": [
								{
									"name": "Copy_Tables",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "SqlServerSource",
											"sqlReaderQuery": {
												"value": "@concat(\n    'SELECT * FROM [',\n    pipeline().parameters.pDatabase,\n    '].[',\n    item().table_schema,\n    '].[',\n    item().table_name,\n    ']'\n)",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"sink": {
											"type": "DelimitedTextSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "DelimitedTextWriteSettings",
												"quoteAllText": true,
												"fileExtension": ".txt"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "SqlServerOmpremTable",
											"type": "DatasetReference",
											"parameters": {
												"table_name": {
													"value": "@item().table_name",
													"type": "Expression"
												},
												"table_schema": {
													"value": "@item().table_schema",
													"type": "Expression"
												},
												"db_name": "master"
											}
										}
									],
									"outputs": [
										{
											"referenceName": "input_sink_dataset",
											"type": "DatasetReference",
											"parameters": {
												"inputcontainer": {
													"value": "@pipeline().parameters.inputcontainer",
													"type": "Expression"
												},
												"inputdirectory": {
													"value": "@concat(\n    pipeline().parameters.inputfolder,\n    '/',\n    pipeline().parameters.pDatabase,\n    '/',\n    item().table_schema\n)",
													"type": "Expression"
												},
												"inputfile": {
													"value": "@concat(\n    item().table_name,\n    '.csv'\n)",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"pTables": {
						"type": "array"
					},
					"pDatabase": {
						"type": "string"
					},
					"inputcontainer": {
						"type": "string"
					},
					"inputfolder": {
						"type": "string"
					},
					"inputfile": {
						"type": "string"
					},
					"sink_container": {
						"type": "string",
						"defaultValue": "raw"
					},
					"sink_folder": {
						"type": "string",
						"defaultValue": "bronze"
					},
					"file_extension": {
						"type": "string",
						"defaultValue": "parquet"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-10-12T19:32:32Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/SqlServerOmpremTable')]",
				"[concat(variables('factoryId'), '/datasets/input_sink_dataset')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Pl_Getmetadata_files')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Get MetadataFiles",
						"type": "GetMetadata",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataset": {
								"referenceName": "Getmetadataset",
								"type": "DatasetReference",
								"parameters": {}
							},
							"fieldList": [
								"childItems"
							],
							"storeSettings": {
								"type": "AzureBlobFSReadSettings",
								"recursive": true,
								"enablePartitionDiscovery": false
							},
							"formatSettings": {
								"type": "DelimitedTextReadSettings"
							}
						}
					},
					{
						"name": "ForEachet",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "FilterOnlyParquetFiles",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('FilterOnlyParquetFiles').output.value",
								"type": "Expression"
							},
							"activities": [
								{
									"name": "Copy dataFrom_Getmetadata",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "ParquetSource",
											"storeSettings": {
												"type": "AzureBlobFSReadSettings",
												"recursive": false,
												"wildcardFolderPath": "AdventureWorksLT2025/SalesLT",
												"wildcardFileName": "*.parquet",
												"enablePartitionDiscovery": false
											},
											"formatSettings": {
												"type": "ParquetReadSettings"
											}
										},
										"sink": {
											"type": "ParquetSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "ParquetWriteSettings"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "ParquetSink_dataset",
											"type": "DatasetReference",
											"parameters": {
												"container": "input",
												"folder": " AdventureWorksLT2025/SalesLT",
												"file": {
													"value": "@item().name",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "ParquetSink_dataset",
											"type": "DatasetReference",
											"parameters": {
												"container": "input",
												"folder": "example",
												"file": {
													"value": "@item().name",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						}
					},
					{
						"name": "FilterOnlyParquetFiles",
						"type": "Filter",
						"dependsOn": [
							{
								"activity": "Get MetadataFiles",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Get MetadataFiles').output.childItems\n ",
								"type": "Expression"
							},
							"condition": {
								"value": "@and(equals(item().type, 'File'), endsWith(item().name, '.parquet'))\n",
								"type": "Expression"
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/Getmetadataset')]",
				"[concat(variables('factoryId'), '/datasets/ParquetSink_dataset')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Pl_copyAll_copy_clone')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "This is a pipeline to copy all table",
				"activities": [
					{
						"name": "Lookup_all_database",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
