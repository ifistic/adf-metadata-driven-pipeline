{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "2026-ADF-demo"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/PL_copy_tables')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "ForEach_tables",
						"type": "ForEach",
						"dependsOn": [],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@pipeline().parameters.pTables",
								"type": "Expression"
							},
							"activities": [
								{
									"name": "Copy_Tables",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "SqlServerSource",
											"sqlReaderQuery": {
												"value": "@concat(\n    'SELECT * FROM [',\n    pipeline().parameters.pDatabase,\n    '].[',\n    item().table_schema,\n    '].[',\n    item().table_name,\n    ']'\n)",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"sink": {
											"type": "DelimitedTextSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "DelimitedTextWriteSettings",
												"quoteAllText": true,
												"fileExtension": ".txt"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "SqlServerOmpremTable",
											"type": "DatasetReference",
											"parameters": {
												"table_name": {
													"value": "@item().table_name",
													"type": "Expression"
												},
												"table_schema": {
													"value": "@item().table_schema",
													"type": "Expression"
												},
												"db_name": "master"
											}
										}
									],
									"outputs": [
										{
											"referenceName": "input_sink_dataset",
											"type": "DatasetReference",
											"parameters": {
												"inputcontainer": {
													"value": "@pipeline().parameters.inputcontainer",
													"type": "Expression"
												},
												"inputdirectory": {
													"value": "@concat(\n    pipeline().parameters.inputfolder,\n    '/',\n    pipeline().parameters.pDatabase,\n    '/',\n    item().table_schema\n)",
													"type": "Expression"
												},
												"inputfile": {
													"value": "@concat(\n    item().table_name,\n    '.csv'\n)",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"pTables": {
						"type": "array"
					},
					"pDatabase": {
						"type": "string"
					},
					"inputcontainer": {
						"type": "string"
					},
					"inputfolder": {
						"type": "string"
					},
					"inputfile": {
						"type": "string"
					},
					"sink_container": {
						"type": "string",
						"defaultValue": "raw"
					},
					"sink_folder": {
						"type": "string",
						"defaultValue": "bronze"
					},
					"file_extension": {
						"type": "string",
						"defaultValue": "parquet"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-10-12T19:32:32Z"
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/Pl_copy_database')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Lookup_tables",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "SqlServerSource",
								"sqlReaderQuery": " SELECT TABLE_SCHEMA, TABLE_NAME\n    FROM INFORMATION_SCHEMA.TABLES\n     WHERE TABLE_TYPE = 'BASE TABLE'",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "SqlServerOmpremTable",
								"type": "DatasetReference",
								"parameters": {
									"table_name": "placeholder",
									"table_schema": "dbo",
									"db_name": {
										"value": "@pipeline().parameters.db_name",
										"type": "Expression"
									}
								}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "ForEach_table",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "Lookup_tables",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Lookup_tables').output.value",
								"type": "Expression"
							},
							"batchCount": 4,
							"activities": [
								{
									"name": "Copy data_table",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "SqlServerSource",
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"sink": {
											"type": "DelimitedTextSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "DelimitedTextWriteSettings",
												"quoteAllText": true,
												"fileExtension": ".txt"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "SqlServerOmpremTable",
											"type": "DatasetReference",
											"parameters": {
												"table_name": {
													"value": "@item().table_name",
													"type": "Expression"
												},
												"table_schema": {
													"value": "@item().table_schema",
													"type": "Expression"
												},
												"db_name": {
													"value": "@pipeline().parameters.db_name",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "input_sink_dataset",
											"type": "DatasetReference",
											"parameters": {
												"inputcontainer": {
													"value": "@pipeline().parameters.sink_container",
													"type": "Expression"
												},
												"inputdirectory": {
													"value": "@{pipeline().parameters.sink_folder}/@{pipeline().parameters.db_name}/@{item().TABLE_SCHEMA}",
													"type": "Expression"
												},
												"inputfile": {
													"value": "@{item().TABLE_NAME}.@{pipeline().parameters.file_extension}",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"db_name": {
						"type": "string"
					},
					"sink_container": {
						"type": "string",
						"defaultValue": "raw"
					},
					"sink_folder": {
						"type": "string",
						"defaultValue": "bronze"
					},
					"file_extension": {
						"type": "string",
						"defaultValue": ".parquet"
					}
				},
				"variables": {
					"p_lodeDate": {
						"type": "String"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-10-16T18:02:53Z"
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/Pl_copyAll_copy_clone')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "This is a pipeline to copy all table",
				"activities": [
					{
						"name": "Lookup_all_database",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "SqlServerSource",
								"sqlReaderQuery": "SELECT\n    name AS database_name\nFROM sys.databases\nWHERE state_desc = 'ONLINE'\n  AND database_id > 4\nORDER BY name;",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "SqlServerOmpremTable",
								"type": "DatasetReference",
								"parameters": {
									"table_name": "amazon",
									"table_schema": "dbo",
									"db_name": "master"
								}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "ForEach_database",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "Lookup_all_database",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Lookup_all_database').output.value",
								"type": "Expression"
							},
							"isSequential": false,
							"batchCount": 4,
							"activities": [
								{
									"name": "Execute Pipeline-childPipeline",
									"type": "ExecutePipeline",
									"dependsOn": [],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "Pl_copy_database",
											"type": "PipelineReference"
										},
										"waitOnCompletion": false,
										"parameters": {
											"db_name": {
												"value": "@item().database_name",
												"type": "Expression"
											},
											"sink_container": {
												"value": "@pipeline().parameters.sink_container",
												"type": "Expression"
											},
											"sink_folder": {
												"value": "@pipeline().parameters.sink_folder",
												"type": "Expression"
											},
											"file_extension": {
												"value": "@pipeline().parameters.file_extension",
												"type": "Expression"
											}
										}
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"sink_container": {
						"type": "string"
					},
					"sink_folder": {
						"type": "string",
						"defaultValue": "bronze"
					},
					"file_extension": {
						"type": "string"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-10-16T18:02:54Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/pipelines/Pl_copy_database')]"
			]
		}
	]
}